{
  "name": "Google Sheets New Lead to Flask",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Form Responses 1",
          "mode": "name"
        },
        "options": {}
      },
      "id": "1",
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5000/api/leads",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { name: $json['Name'], email: $json['Email'], phone: $json['Phone Number'], company: $json['Company'], message: $json['Requirement'] } }}",
        "options": {}
      },
      "id": "2",
      "name": "Create Lead in Flask",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:5000/api/leads/{{$json.lead.id}}/analyze",
        "options": {}
      },
      "id": "3",
      "name": "Analyze Lead with Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Google Sheets Trigger": {
      "main": [
        [
          {
            "node": "Create Lead in Flask",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Lead in Flask": {
      "main": [
        [
          {
            "node": "Analyze Lead with Ollama",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}